# brand.rs and brand.js are regenerated from scratch by tools/brand.js on every
# rebrand, always as LF. Without this, core.autocrlf=true converts them to CRLF
# on checkout, so the very next rebrand re-writes them as LF and dirties the tree
# even when nothing about the brand changed.
src-tauri/src/brand.rs text eol=lf
ui/brand.js text eol=lf

# Same story for the third-party notice list: src-tauri/build.rs regenerates it
# from the real dependency manifests on every build, always as LF.
THIRD-PARTY-NOTICES.md text eol=lf
graphify-out/graph.json merge=graphify

# lib.rs has always been stored byte for byte (CRLF) because it once held raw NUL
# bytes; keep it that way so its history keeps lining up line for line.
src-tauri/src/lib.rs -text

# Generated by tools/gen_ui_ranges.js, always as LF, like brand.rs.
src-tauri/src/ui_ranges.rs text eol=lf

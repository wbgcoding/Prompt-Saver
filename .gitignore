# Build output
node_modules/
dist/
build/
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/permissions/autogenerated/

# pdfium: downloaded separately, see "Building from source" in the README
pdfium.dll
pdfium-LICENSE

# ffmpeg: downloaded separately, see "Building from source" in the README
ffmpeg.exe
ffprobe.exe
ffmpeg-LICENSE

# Editor / OS / logs
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.log
__pycache__/

# User data lives in %APPDATA% or next to the portable exe, never in the repo
data.db
*.db
*.db-wal
*.db-shm
prompts.json
settings.json
backups/
*.psb
test-data/

# Secrets: a signing certificate or a token must never reach the repo
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt

# scratch space for the working session (never committed)
.tmp/

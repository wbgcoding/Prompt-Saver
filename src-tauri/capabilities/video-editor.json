{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "video-editor",
  "description": "Screen recording and video editor: only the commands its page calls",
  "windows": [
    "video-editor"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-scale-factor",
    "core:window:allow-theme",
    "core:event:default",
    "allow-cancel-export",
    "allow-cancel-ffmpeg-download",
    "allow-check-export-disk-space",
    "allow-clip-export-path",
    "allow-copy-file-to-clipboard",
    "allow-copy-text",
    "allow-current-theme",
    "allow-discard-edit-state",
    "allow-download-ffmpeg",
    "allow-grant-ffmpeg-download-consent",
    "allow-estimate-export-size",
    "allow-export-video",
    "allow-extract-still-frame",
    "allow-generate-filmstrip",
    "allow-generate-waveform-peaks",
    "allow-get-settings",
    "allow-ink-prefs",
    "allow-load-edit-state",
    "allow-allow-edit-state-files",
    "allow-log-error",
    "allow-mux-mic-track",
    "allow-pick-export-folder",
    "allow-pick-file-path",
    "allow-probe-extra-video-source",
    "allow-probe-recording",
    "allow-read-camera-sidecar",
    "allow-read-key-sidecar",
    "allow-record-tool-usage",
    "allow-save-edit-state",
    "allow-save-recording-as",
    "allow-set-ui-text",
    "allow-set-ui-value",
    "allow-set-video-export-dir",
    "allow-stat-file",
    "allow-theme-vars",
    "allow-video-editor-add-tile",
    "allow-video-editor-close-ack",
    "allow-video-editor-load-ack",
    "allow-video-editor-source",
    "allow-windows-fonts-dir"
  ]
}

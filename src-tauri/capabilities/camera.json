{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "camera",
  "description": "Camera recording window: only the commands its page calls",
  "windows": [
    "camera"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-scale-factor",
    "core:window:allow-theme",
    "core:event:default",
    "allow-camera-abandon-recording",
    "allow-camera-append-chunk",
    "allow-camera-begin-recording",
    "allow-camera-discard-recording",
    "allow-camera-finish-recording",
    "allow-camera-mark-finishing",
    "allow-camera-permission-ready",
    "allow-camera-permission-failed",
    "allow-camera-screen-elapsed-ms",
    "allow-current-theme",
    "allow-default-recording-dir",
    "allow-get-settings",
    "allow-ink-prefs",
    "allow-log-error",
    "allow-open-video-editor",
    "allow-pick-folder",
    "allow-set-recording-dir",
    "allow-theme-vars"
  ]
}

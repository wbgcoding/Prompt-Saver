{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Saver",
  "version": "2.7.0",
  "identifier": "com.bgcoding.promptsaver",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prompt Saver",
        "width": 880,
        "height": 600,
        "minWidth": 360,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": { "enable": true, "scope": { "allow": ["**"], "deny": ["**/data.db", "**/data.db-wal", "**/data.db-shm", "**/Prompt-Saver/settings.json", "**/Prompt-Saver/prompts.json"] } }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/installer-icon.ico",
        "languages": ["English", "German", "Spanish", "Italian", "PortugueseBR", "Polish", "Russian", "SimpChinese", "Japanese", "Dutch", "Turkish", "Korean", "Romanian"],
        "customLanguageFiles": {
          "German": "nsis-languages/German.nsh",
          "Polish": "nsis-languages/Polish.nsh",
          "Romanian": "nsis-languages/Romanian.nsh"
        },
        "template": "installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
